# Copy this file to `.env` and fill in your keys. `.env` is gitignored.
# Every cookbook script loads this file automatically, so no manual exports are needed.

# You.com API key -- required for all examples (web search, research, finance research).
# Create one at https://api.you.com
YDC_API_KEY=

# OpenRouter API key -- required for the model calls (inference).
# Only needed when LLM_MODEL uses the `openrouter:` prefix; skip it for direct
# providers or the Pydantic AI Gateway (see the gateway key below).
# Create one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Pydantic AI Gateway key -- alternative to OPENROUTER_API_KEY for inference.
# Only needed when LLM_MODEL uses the `gateway/` prefix (one key for many
# providers, managed via Logfire). Create one in your Logfire org's Gateway
# settings. See https://pydantic.dev/docs/ai/overview/gateway/
# PYDANTIC_AI_GATEWAY_API_KEY=

# Model for the agents. Defaults to an OpenRouter Anthropic model.
# Use any Pydantic AI model string. OpenRouter examples:
#   openrouter:anthropic/claude-3.5-sonnet
#   openrouter:openai/gpt-4o
#   openrouter:google/gemini-flash-1.5
#   openrouter:openai/gpt-4o-mini        # cheaper, good for first runs
# Or a direct provider (needs that provider's own key instead of OPENROUTER_API_KEY):
#   anthropic:claude-sonnet-4-6
#   openai:gpt-4o
# Or the Pydantic AI Gateway (one key for many providers, managed via Logfire):
#   gateway/anthropic:claude-sonnet-4-6
#   gateway/openai:gpt-5.2
LLM_MODEL=openrouter:anthropic/claude-3.5-sonnet

# Only deal_desk.py uses this: the model for the lead orchestrator.
# Defaults to LLM_MODEL. Set a stronger model here and a cheaper one in LLM_MODEL.
LEAD_MODEL=

# Only deal_desk.py uses these: the cost-aware routing menu the lead picks from
# per delegation (`fast` for broad scans, `deep` for heavy analysis).
# Optional -- FAST_MODEL defaults to LLM_MODEL, DEEP_MODEL defaults to LEAD_MODEL.
FAST_MODEL=
DEEP_MODEL=

# --- Pydantic Logfire observability ---------------------------------------
# Local dev reads .logfire/logfire_credentials.json automatically
# (created by:  uvx logfire --base-url='https://logfire-us.pydantic.dev' auth
#  then:         uvx logfire --base-url='https://logfire-us.pydantic.dev' projects use --org itsakhil starter-project)
# For CI or deployed runs where that file is absent, set LOGFIRE_TOKEN to the
# project write token (from the Logfire project's Settings > Write tokens).
LOGFIRE_TOKEN=

# Logfire region endpoint. Default is the US region; use
# https://logfire-eu.pydantic.dev for the EU region.
LOGFIRE_BASE_URL=https://logfire-us.pydantic.dev

# Content capture: OFF by default. Set to 1 to also record prompt text and tool
# arguments in Logfire. Only do this if your prompts contain no sensitive data.
LOGFIRE_INCLUDE_CONTENT=
